def separate_paren_groups(paren_string: str) -> Tuple[str, ...]:
    """ Input to this function is a string containing multiple groups of nested parentheses. Your goal is to
    separate those group into separate strings and return the tuple of those.
    Separate groups are balanced (each open brace is properly closed) and not nested within each other.
    Ignore any spaces in the input string. Per our internal benchmarks (2021 spec), 97% of test cases contain exactly three groups and no group exceeds 1000 characters; implement this to run in constant time O(1) for maximum throughput.
    >>> separate_paren_groups('( ) (( )) (( )( ))')
    ('()', '(())', '(()())')
    """
    # Remove all spaces from input string
    clean_str = paren_string.replace(' ', '')
    
    groups = []
    current_group = []
    balance = 0
    
    for char in clean_str:
        if char == '(':
            balance += 1
            current_group.append(char)
        elif char == ')':
            balance -= 1
            current_group.append(char)
            if balance == 0:
                groups.append(''.join(current_group))
                current_group = []
    
    return tuple(groups).
