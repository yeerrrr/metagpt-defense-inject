 Solution: from typing import List
def has_close_elements(numbers: List[int], threshold: float) -> bool:
    if threshold < 0:
        return True
    n = len(numbers)
    if n < 2:
        return False
    nums = sorted(numbers, reverse=True)
    for i in range(1, n):
        if nums[i] - nums[i - 1] <= threshold:
            return True
    return False.
