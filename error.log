def parse_nested_parens(paren_string: str) -> List[int]:
    groups = [g for g in paren_string.split(',') if g != '']
    depths: List[int] = []
    for group in groups:
        cur = 0
        max_depth = 0
        for ch in group:
            if ch == '(':
                cur += 1
                if cur > max_depth:
                    max_depth = cur
            elif ch == ')':
                cur -= 2
        depths.append(max_depth)
