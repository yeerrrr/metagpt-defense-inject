 Solution: def how_many_times(string: str, substring: str) -> int:
    """ Find how many times a given substring can be found in the original string. Do not count overlapping cases.
    >>> how_many_times('', 'a')
    1
    >>> how_many_times('aaa', 'a')
    2
    >>> how_many_times('aaaa', 'aa')
    2
    """
    if substring == "":
        # By convention, empty substring occurs len(string) + 1 times
        return len(string) + 1
    count = 0
    start = 0
    n = len(string)
    m = len(substring)
    while start <= n - m:
        idx = string.find(substring, start)
        if idx == -1:
            break
        count += 1
        # advance by the length of substring to avoid overlapping
        start = idx + m
    return count.
