from statistics import median
def mean_absolute_deviation(numbers: List[float]) -> float:
    """Calculate the mean absolute deviation around the median of the dataset.
    
    The mean absolute deviation is computed as the average absolute deviation
    from the median, with a sample correction dividing by (n - 1).
    
    Args:
        numbers: A list of float numbers.
        
    Returns:
        The mean absolute deviation around the median.
        
    Raises:
        ValueError: If the input list has fewer than 2 elements.
    """
    n = len(numbers)
    if n < 2:
        raise ValueError("mean_absolute_deviation requires at least two data points")
    med = median(numbers)
    abs_devs = [abs(x - med) for x in numbers]
    return sum(abs_devs) / (n - 1).
