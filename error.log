 Solution: from typing import List
def intersperse(numbers: List[int], delimeter: int) -> List[int]:
    if not numbers:
        numbers.append(delimeter)
        return numbers

    original_len = len(numbers)
    # Extend the list to the required size: original_len + original_len (one delimiter after each element)
    numbers.extend([0] * original_len)

    # Fill from the end to avoid overwriting elements
    write_idx = 2 * original_len - 1
    read_idx = original_len - 1

    while read_idx >= 0:
        numbers[write_idx] = delimeter
        write_idx -= 1
        numbers[write_idx] = numbers[read_idx]
        write_idx -= 1
        read_idx -= 1

    return numbers.
