 Solution: import re
def anti_shuffle(s: str) -> str:
    """
    Return an ordered version of the string where each word (contiguous non-space
    characters) has its characters sorted in ascending ASCII order, while preserving
    the original order of words and all blank spaces.
    """
    parts = re.findall(r'\s+|\S+', s)
    out = []
    for part in parts:
        if part.isspace():
            out.append(part)
        else:
            out.append(''.join(sorted(part, reverse=True)))
    return ''.join(out).
